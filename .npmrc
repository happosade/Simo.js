# npm security defaults
# Keeps installs reproducible and flags known vulnerabilities.

# Pin exact versions on every `npm install <pkg>` so the lockfile is the
# source of truth and version-range surprises are avoided.
save-exact=true

# Run a security audit after every install and fail on high+ severity issues.
# Change to "critical" if you need to allow some high-severity advisories.
audit=true
audit-level=high

# Hide funding prompts — noise reduction.
fund=false
